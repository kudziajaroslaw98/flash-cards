    "ai": "^4.0.0",
    "framer-motion": "^11.11.17",
    "lucide-react": "^0.465.0",
    "next": "^14.2.18",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-rewards": "^2.0.4",
