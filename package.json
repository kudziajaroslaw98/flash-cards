    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.465.0",
    "motion": "^11.18.0",
    "next": "15.1.4",
    "next-mdx-remote": "^5.0.0",
    "postcss": "^8.5.1",
    "react": "19.0.0",
    "react-dom": "19.0.0",
